# Copy this file to /opt/pav/backend.env on the VPS and set production values.
# Do not commit the copied file: it can contain Synapse credentials.
HOST=0.0.0.0
PORT=8091

SYNAPSE_URL=
SYNAPSE_USER=
SYNAPSE_PASSWORD=
SYNAPSE_UI_URL=
SYNAPSE_WORKFLOW_ID=
SYNAPSE_APPROVAL_MODE=human
SYNAPSE_TIMEOUT=30

# This path is mounted as the persistent document_store volume by compose.yml.
# DOCUMENT_ACCESS_TOKEN belongs in /opt/pav/.env because compose requires it
# before the backend container starts. Leave it unset only for local development.
DOCUMENT_STORE_DIR=/service/var/documents
DOCUMENT_MAX_UPLOAD_BYTES=20971520
DOCUMENT_MAX_DOCUMENTS=100
DOCUMENT_MAX_PAGES=200
DOCUMENT_MAX_RECORDS=100000
DOCUMENT_MAX_EXTRACTED_CHARS=2000000
DOCUMENT_CHUNK_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150
DOCUMENT_MAX_PAGE_CONTENT_BYTES=16777216
