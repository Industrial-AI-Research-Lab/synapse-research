# GHCR image paths require a lowercase owner name.
GHCR_OWNER=industrial-ai-research-lab

# Only commit tags are published; manual starts need the same full SHA.
IMAGE_TAG=

# A domain enables Caddy HTTPS after its DNS A record points to the VPS.
CADDY_SITE_ADDRESS=:80

HOST=0.0.0.0
PORT=8091
PAV_HTTP_TRACE_ENABLED=false

SYNAPSE_URL=
SYNAPSE_UI_URL=
SYNAPSE_USER=
SYNAPSE_PASSWORD=
SYNAPSE_WORKFLOW_ID=
SYNAPSE_DOCUMENT_WORKFLOW_ID=
SYNAPSE_DOCUMENT_RUN_CONFIG_ID=agent-owned-models
SYNAPSE_APPROVAL_MODE=human
SYNAPSE_TIMEOUT=300

# An empty token stops production startup; set a random team code on the VPS.
DOCUMENT_ACCESS_TOKEN=
DOCUMENT_ACCESS_CODE_COPY_ENABLED=false
DOCUMENT_STORE_DIR=/service/var/documents
DOCUMENT_CHUNK_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150
