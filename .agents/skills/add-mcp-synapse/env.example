# Published MCP from add-mcp-litellm (or an existing global/scoped key)
MCP_SERVER_ID=                     # id inside Synapse, no spaces, e.g. osdu-graph-ro
MCP_PUBLIC_URL=                    # e.g. https://admin.duckduck.cloud/{alias}/mcp
LITELLM_MCP_KEY=                   # scoped or approved global AI APIs key; goes into Synapse

# Synapse
SYNAPSE_URL=https://synapse.bonpp.com
SYNAPSE_TENANT_ID=
SYNAPSE_ADMIN_EMAIL=
SYNAPSE_ADMIN_PASSWORD=
