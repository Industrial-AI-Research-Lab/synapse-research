# LiteLLM proxy
LITELLM_ADMIN_URL=https://admin.duckduck.cloud
LITELLM_ADMIN_KEY=                 # Full Access key; Management-only keys cannot call /v1/mcp/*
LITELLM_TEAM=Codesynapse
LITELLM_MCP_KEY=                   # scoped AI APIs key created by add-mcp-litellm; later goes into Synapse

# The deployed MCP, as it is reachable from LiteLLM
MCP_SERVER_ID=                     # published alias/id, no spaces, e.g. osdu-graph-ro
MCP_INTERNAL_URL=                  # e.g. http://10.32.15.21:18081/
MCP_UPSTREAM_TOKEN=                # optional: the MCP's own auth token, if it has one
MCP_PUBLIC_URL=                    # public MCP URL, form $LITELLM_ADMIN_URL/{alias}/mcp
