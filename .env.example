# Локальный стенд
HOST=0.0.0.0
PORT=8091

# Включает безопасную трассировку API: метод, путь, размер, статус, длительность
# и корреляционный X-Request-ID. Тела запросов, PDF и секреты в лог не пишутся.
PAV_HTTP_TRACE_ENABLED=false

# Synapse. Скопируйте значения со стенда, секреты не коммитить.
SYNAPSE_URL=
SYNAPSE_USER=
SYNAPSE_PASSWORD=
SYNAPSE_UI_URL=
SYNAPSE_WORKFLOW_ID=
# Optional dedicated workflow for research over the selected PDFs. If empty,
# SYNAPSE_WORKFLOW_ID is used. Synapse expects the workflow UUID, not its display name.
SYNAPSE_DOCUMENT_WORKFLOW_ID=
# Optional run configuration for the document workflow. Keep models selected
# by the workflow agents instead of overriding them with the tenant default.
SYNAPSE_DOCUMENT_RUN_CONFIG_ID=
SYNAPSE_APPROVAL_MODE=human
SYNAPSE_TIMEOUT=300

# Local document corpus (PDF scans still require OCR)
# Leave empty to keep document routes unauthenticated during local development.
DOCUMENT_ACCESS_TOKEN=
# Temporary stand-only feature: lets users copy the shared document code from the UI.
# Keep false in production and remove the feature before release.
DOCUMENT_ACCESS_CODE_COPY_ENABLED=false
DOCUMENT_CHUNK_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150
